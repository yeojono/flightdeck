{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wheel-insights",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // The React app is served as static assets; /api/* always goes to the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Run `npx wrangler d1 create wheel-insights` and paste the database_id it prints.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wheel-insights",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Durable, resumable order sync (one instance per store per sync run).
  "workflows": [
    { "name": "wheel-insights-sync", "binding": "SYNC", "class_name": "SyncWorkflow" }
  ],

  // Incremental sync of every connected store, every 6 hours.
  "triggers": { "crons": ["0 */6 * * *"] },

  "vars": {
    "SHOPIFY_API_VERSION": "2026-10",
    // Bytes of the Shopify export processed per workflow step.
    "INGEST_CHUNK_BYTES": "4000000"
  }

  // Secrets (set with `npx wrangler secret put NAME`, or in .dev.vars locally):
  //   ADMIN_PASSWORD  - password for signing in to the dashboard
  //   APP_SECRET      - long random string; encrypts Shopify credentials and signs sessions
}
