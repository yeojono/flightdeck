{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flightdeck",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // The React app is served as static assets; /api/* always goes to the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Run `pnpm exec wrangler d1 create flightdeck` and paste the database_id it prints.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flightdeck",
      "database_id": "67997891-e519-49c6-aadd-86b2f5dae815",
      "migrations_dir": "migrations"
    }
  ],

  // Durable, resumable order sync (one instance per store per sync run).
  "workflows": [
    { "name": "flightdeck-sync", "binding": "SYNC", "class_name": "SyncWorkflow" }
  ],

  // Incremental sync of every connected store, every 6 hours.
  "triggers": { "crons": ["0 */6 * * *"] },

  "vars": {
    "SHOPIFY_API_VERSION": "2026-10",
    // Bytes of the Shopify export processed per workflow step.
    "INGEST_CHUNK_BYTES": "4000000",
    // Required for sign-in (see "Protect it with Cloudflare Access" in the README): the Zero Trust
    // team domain and the Access application's AUD tag. Not secret.
    "ACCESS_TEAM_DOMAIN": "ride-wingman.cloudflareaccess.com",
    "ACCESS_AUD": "808d629362b15887b2a1bc6b91ec57870cea7808659c6c64f3810c22c65a57b0"
  },

  // Sign-in is Cloudflare Access (Workers & Pages > flightdeck > Access). This block only applies to local
  // dev (`pnpm run dev`), where it pretends every request is signed in as this identity.
  "access": {
    "dev": {
      "aud": "local-dev",
      "identity": { "email": "dev@localhost" }
    }
  }

  // Secret (set with `pnpm exec wrangler secret put APP_SECRET`, or in .dev.vars locally):
  //   APP_SECRET - long random string; encrypts the stored Shopify credentials
}
