# Copy to .dev.vars for local development. In production set these with `wrangler secret put`.
ADMIN_PASSWORD=choose-a-password
APP_SECRET=a-long-random-string-at-least-32-characters

# Local testing against the fake Shopify server only (npm run mock:shopify). Never set in production.
# SHOPIFY_ORIGIN_OVERRIDE=http://127.0.0.1:8799
